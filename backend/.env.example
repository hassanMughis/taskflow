# Local PostgreSQL settings (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=postgres
DB_PASSWORD=replace_me

# Hosted PostgreSQL alternative (recommended for Neon/Render)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DB_SSL=false
DB_POOL_MAX=5

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
PORT=3000
